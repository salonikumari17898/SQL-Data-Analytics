 --  Objective 1: Analyzing Sales Performance  
 -- What is the total sales amount generated by each sales representative?
 Select SalesRepID,sum(TotalAmount)as Total_sales from sales group by SalesRepID
 order by Total_sales Desc;
 
 SELECT 
    s.SalesRepID,
    r.FirstName,
    r.LastName,
    SUM(s.TotalAmount) AS Total_sales
FROM sales s
JOIN sales_reps r
    ON s.SalesRepID = r.SalesRepID
GROUP BY 
    s.SalesRepID,
    r.FirstName,
    r.LastName
ORDER BY Total_sales asc;
-- How many products have been sold in each store location?
select 
StoreLocation ,sum(Quantity)as Total_Products_Sold
From sales
Group by StoreLocation 
Order by Total_Products_Sold Desc;
-- Which product category has the highest total sales amount?
select
p.Category,sum(TotalAmount) as Total_Sales from products p
join Sales s 
on p. ProductID = s.ProductID
group by p.Category
order by Total_Sales desc;

-- What is the average quantity of products sold per sale?
SELECT
    AVG(Quantity) AS Average_Quantity
FROM sales;

-- Which customer has made the highest number of purchases?
select 
c.FirstName,
c.LastName,MAX(s.TotalAmount) as Total_Sales from Customers c
join Sales s
 on c.CustomerID = s.CustomerID;
 
 -- What is the distribution of total sales amounts across different months?
SELECT
    MONTHNAME(SaleDate) AS Month_Name,
    SUM(TotalAmount) AS Total_Sales
FROM Sales
GROUP BY MONTH(SaleDate), MONTHNAME(SaleDate)
ORDER BY MONTH(SaleDate);
-- How does the sales performance of different regions compare?
SELECT
    r.Region,
    SUM(s.TotalAmount) AS Total_Sales
FROM sales s
JOIN sales_reps r
    ON s.SalesRepID = r.SalesRepID
GROUP BY r.Region
ORDER BY Total_Sales DESC;
-- What is the total sales amount generated for each product?
select
p.ProductName,
SUM(p.UnitPrice) AS Total_Amount from products p
join sales s
on s.ProductID = p.ProductID
group by p.ProductName
ORDER BY Total_Amount DESC;
SELECT
    p.ProductID,
    p.ProductName,
    SUM(s.TotalAmount) AS Total_Sales
FROM products p
JOIN sales s
    ON s.ProductID = p.ProductID
GROUP BY
    p.ProductID,
    p.ProductName
ORDER BY Total_Sales DESC;
-- What is the average sales amount per transaction? 
SELECT 
    AVG(TotalAmount) AS Average_Sales
FROM sales;
-- How many sales transactions were made by each sales representative?
SELECT
    r.SalesRepID,
    r.FirstName,
    r.LastName,
    COUNT(s.SaleID) AS Number_of_Transactions
FROM sales_reps r
JOIN sales s
    ON s.SalesRepID = r.SalesRepID
GROUP BY
    r.SalesRepID,
    r.FirstName,
    r.LastName
ORDER BY Number_of_Transactions DESC;
