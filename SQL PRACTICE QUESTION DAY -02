-- Display all employees.
select * from employees;
-- Display only the first name, last name, and salary of employees.
SELECT FirstName, LastName, Salary
FROM Employees;
-- Find employees whose salary is greater than 60,000.
SELECT
    EmployeeID,
    FirstName,
    LastName,
    Salary
FROM Employees
WHERE Salary > 60000;
-- Find employees who live in Delhi.
select
EmployeeID,
    FirstName,
    LastName,
    City
    FROM Employees
    Where City= 'Delhi';
    -- Display employees whose salary is between 50,000 and 70,000.
    SELECT
    EmployeeID,
    FirstName,
    LastName,
    Salary
FROM Employees
WHERE Salary BETWEEN 50000 AND 70000;
-- Display employees whose first name starts with J.
SELECT
    EmployeeID,
    FirstName,
    LastName
    from Employees
    Where FirstName like 'J%';
   --  Display all unique cities where employees live.
  SELECT DISTINCT City
FROM Employees;
-- Display employees in descending order of salary.
Select 
FirstName,
LastName,
Salary
from Employees
order by Salary desc;
-- Find the employee with the highest salary.
SELECT
    FirstName,
    LastName,
    Salary
FROM Employees
WHERE Salary = (
    SELECT MAX(Salary)
    FROM Employees
);
-- Find the top 3 highest-paid employees.
select 
FirstName,
Salary
from Employees
ORDER BY Salary DESC
LIMIT 3;
-- LEVEL 2 — Aggregate Functions
-- Find the total number of employees.
SELECT COUNT(EmployeeID) AS Total_Employees
FROM Employees;
-- Find the average salary of all employees
SELECT AVG(Salary)
FROM Employees;
-- Find the highest and lowest salary.
select max(Salary),min(Salary) from Employees;
-- Find the total salary paid to all employees.
select sum(Salary) as Total_Salary from Employees;
-- Find the number of employees in each department.
SELECT
    DepartmentID,
    COUNT(EmployeeID) AS Number_of_Employees
FROM Employees
GROUP BY DepartmentID;
-- Find the average salary of each department
SELECT
    DepartmentID,
    AVG(Salary) AS Average_Salary
FROM Employees
GROUP BY DepartmentID;
-- Find the highest salary in each department
SELECT
    DepartmentID,
    Max(Salary) AS Highest_Salary
FROM Employees
GROUP BY DepartmentID; 

-- Find departments having more than 2 employees
SELECT
    DepartmentID,
    COUNT(EmployeeID) AS Number_of_Employees
FROM Employees
GROUP BY DepartmentID
HAVING COUNT(EmployeeID) > 2;
-- Find departments where the average salary is greater than 60,000.
SELECT
    DepartmentID,
    AVG(Salary) AS Average_Salary
FROM Employees
GROUP BY DepartmentID
HAVING AVG(Salary) > 60000;

-- Find cities having more than 1 employee.
SELECT
    City,
    COUNT(EmployeeID) AS Number_of_Employees
FROM Employees
GROUP BY City
HAVING COUNT(EmployeeID) > 1;
-- Find departments where the highest salary is greater than 70,000.
select 
DepartmentID,
max(Salary) as Highest_Salary from Employees
group by DepartmentID
having max(Salary)>70000;
