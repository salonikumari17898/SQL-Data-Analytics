CREATE DATABASE sales_db;
USE sales_db;
CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    customer_name VARCHAR(50),
    city VARCHAR(50),
    product VARCHAR(50),
    category VARCHAR(50),
    payment_method VARCHAR(30),
    sales DECIMAL(10,2)
);
