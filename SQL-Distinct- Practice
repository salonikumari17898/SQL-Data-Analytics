-- Q1. Find all unique cities from the orders table.
select distinct city  from orders;
-- Q2. Find all unique product names.
select distinct product from orders;
-- Find all unique product categories.
select distinct category from orders;
-- Find all unique payment methods.
select distinct payment_method from orders;
-- Find all unique customer names.
select distinct customer_name from orders;
-- How many different cities are present in the dataset?
select count(distinct city) as unique_cities from orders;
-- How many unique customers have placed orders?
select count(distinct customer_name)as unique_customers from orders;
-- How many unique products are sold?
select count(distinct product) as unique_product from orders; 
-- How many different payment methods are used?
select count(distinct payment_method) as payment_method from orders;
-- Find unique combinations of city and category.
select distinct city, category from orders;
-- Find unique combinations of customer and city.
select distinct customer_name ,city from orders;
-- Find unique combinations of product and payment method.
select distinct product ,payment_method from orders;
SELECT DISTINCT customer_name, city
FROM orders;
-- Find the number of unique customers from Delhi.
select count(distinct customer_name)as unique_customers
 from orders
where city ="Delhi";

-- Find the number of unique products in the Electronics category.
SELECT COUNT(DISTINCT product) AS unique_products
FROM orders
WHERE category = 'Electronics';
-- Find unique payment methods used for orders from Mumbai.
select count(distinct payment_method)as payment_method
from orders
where city = 'Mumbai';
-- Find unique customers who purchased a Laptop.
